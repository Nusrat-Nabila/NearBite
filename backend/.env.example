# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# Gmail address and app password used to send emails (password reset, request approved/declined)
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_MB=10

# Optional place-search settings (these are the defaults)
NOMINATIM_COUNTRY_CODES=bd
NOMINATIM_LANGUAGE=en
